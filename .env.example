# =============================================================================
# SECURITY NOTICE (ASVS V13.3.1)
# =============================================================================
# All lines marked REPLACE_ME MUST be replaced with real values before any
# non-laptop deployment. The application refuses to start if it detects
# placeholder values (see app.config.config Settings validator).
#
# For production deployments, source these values from a secrets manager
# (HashiCorp Vault, AWS Secrets Manager, or a SOPS-encrypted file) rather
# than a hand-edited .env file — per ASVS V13.3.1.
#
# Variables marked [LONG-LIVED CREDENTIAL] should be rotated per your
# organisation's secret-rotation policy before any deployment.
# =============================================================================

# =============================================================================
# MODULAR SETUP (written by setup.sh — see the modular-setup ADR)
# =============================================================================
# SCCAP_VARIANT selects the packaging tier; the app seeds its feature flags
# from it on first boot. One of: vibe_coder | developer | enterprise | custom.
# Unset is treated as `enterprise` (every feature) — the non-breaking default
# for installs predating modular setup.
SCCAP_VARIANT=enterprise
# COMPOSE_PROFILES selects which optional container stacks boot. Comma-
# separated. `log_stack` = Fluentd/Loki/Grafana + disk-monitor; `tracing` =
# the 6-container Langfuse stack. Empty = core services only. A container-
# backed feature flag is only honoured when its profile is listed here.
COMPOSE_PROFILES=log_stack

# CLASSIFICATION: internal (database user)
POSTGRES_USER=postgres
# CLASSIFICATION: secret (DB credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=secure_coding_platform
# CLASSIFICATION: internal (message broker user) [LONG-LIVED CREDENTIAL — rotate before deploy]
RABBITMQ_DEFAULT_USER=user
# CLASSIFICATION: secret (message broker credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 32
RABBITMQ_DEFAULT_PASS=REPLACE_ME
# CLASSIFICATION: secret (Erlang cookie for intra-cluster auth)
# When set, RabbitMQ's entrypoint writes .erlang.cookie with correct 0400
# permissions inside the named Docker volume, avoiding EACCES on hosts
# where volume ownership defaults to root.
RABBITMQ_ERLANG_COOKIE=REPLACE_ME
# CLASSIFICATION: secret (JWT signing key)
# Replace with a strong random value, e.g.: openssl rand -hex 32
SECRET_KEY=REPLACE_ME
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
# Explicitly opt into HTTP-only local development. Compose maps this to the
# backend refresh-cookie policy; never enable it in production.
SSL_DEV_INSECURE=false
# Note: LLM provider API keys (OpenAI, Anthropic, Google) are NOT stored
# as env vars. Admins enter them per-model at Setup or under Admin → LLM
# Configurations; they're Fernet-encrypted in the llm_configurations
# table using ENCRYPTION_KEY below.
# Added variables based on log errors
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_ALEMBIC=db
# Production must set separate explicit URLs: ASYNC_DATABASE_URL uses a
# NOSUPERUSER/NOBYPASSRLS login that does not own application tables;
# ALEMBIC_DATABASE_URL uses the migration owner. The API refuses production
# startup if its runtime/session login can bypass forced RLS. Local Compose may
# omit both and use the derived POSTGRES_* owner URL with a visible warning.
# ASYNC_DATABASE_URL=postgresql+asyncpg://sccap_app:REPLACE_ME@db:5432/secure_coding_platform
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@db:5432/secure_coding_platform
RABBITMQ_HOST=rabbitmq
# CLASSIFICATION: secret (encryption key, do not log)
# REQUIRED. Generate a real Fernet key before any deployment:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# OR: python scripts/generate_secrets.py fernet
# The application refuses to start if this placeholder is not replaced.
ENCRYPTION_KEY=REPLACE_ME_GENERATE_VIA_python_scripts_generate_secrets_py_fernet

# --- Immutable scan evidence store -----------------------------------
# Compose runs a dedicated private MinIO service for SCCAP evidence. These
# credentials are separate from the optional Langfuse MinIO stack.
EVIDENCE_STORE_ENABLED=true
EVIDENCE_S3_ENDPOINT=http://evidence-minio:9000
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_BUCKET=sccap-evidence
EVIDENCE_MINIO_ROOT_USER=sccap-evidence-local
# CLASSIFICATION: secret (evidence object-store credential)
# Replace before every non-laptop deployment.
EVIDENCE_MINIO_ROOT_PASSWORD=REPLACE_ME
EVIDENCE_S3_ACCESS_KEY_ID=sccap-evidence-local
EVIDENCE_S3_SECRET_ACCESS_KEY=REPLACE_ME
EVIDENCE_S3_FORCE_PATH_STYLE=true
# local derives a versioned development KEK from ENCRYPTION_KEY. Every
# non-development environment requires aws_kms plus EVIDENCE_KMS_KEY_ID.
EVIDENCE_KEY_PROVIDER=local
EVIDENCE_KMS_KEY_ID=
# JSON array of old KMS key ARNs retained only during lazy DEK rotation.
EVIDENCE_KMS_PREVIOUS_KEY_IDS=[]
EVIDENCE_RETENTION_DAYS=365
EVIDENCE_DUAL_WRITE_LEGACY=true
RULE_FOUNDRY_KMS_KEY_ID=
RULE_FOUNDRY_KMS_REGION=us-east-1
GOVERNANCE_SIGNING_KMS_KEY_ID=
GOVERNANCE_SIGNING_KMS_REGION=us-east-1
GOVERNANCE_OBSERVABILITY_URL=https://observability-governance.example.invalid
GOVERNANCE_OBSERVABILITY_BEARER_TOKEN=
GOVERNANCE_ARTIFACT_ROOT=/var/lib/sccap/governance
# Isolated-restore operator inputs. Run the recovery gateway and verifier in the
# same isolated container/network namespace; never expose the gateway publicly.
RESTORE_CHECKPOINT_DSN=
RESTORE_QDRANT_ARTIFACT=/var/lib/sccap/restore/qdrant-restore.json
RESTORE_EXPECTED_OBSERVABILITY_SHA256=
RESTORE_OUTBOX_RECEIPT_URL=http://127.0.0.1:8765/v1/restore/outbox-receipts
RESTORE_CHECKPOINT_RESUME_URL=http://127.0.0.1:8765/v1/restore/checkpoint-resume
RESTORE_PROBE_BEARER_TOKEN=
# Set true only when the authenticated recovery gateway is bound to exact loopback.
RESTORE_ALLOW_LOOPBACK_HTTP=false
RESTORE_PROBE_EFFECT_TIMEOUT_SECONDS=300
RESTORE_PROBE_RESUME_TIMEOUT_SECONDS=1800
GOVERNANCE_BACKUP_ROOT=/var/backups/sccap
# Approved Task22 defaults: transactional/audit/evidence/vector 365d,
# LLM/logs 30d, and backups 35d. Legal holds override every expiry.
BACKUP_RETENTION_DAYS=35

# Email Settings (Optional but required for sending user setup emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
# CLASSIFICATION: secret (SMTP credential)
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# --- RAG vector store (Qdrant) ---------------------------------------
# NOTE (ASVS V12.3.3): For non-laptop deployments, front Qdrant with TLS
# (sidecar reverse proxy or service mesh) and set QDRANT_USE_HTTPS=true
# with QDRANT_PORT=6334. Plain HTTP is dev-only.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Uncomment and set for TLS (ASVS L2 requirement for non-laptop deploys):
# QDRANT_USE_HTTPS=true
# QDRANT_PORT=6334
# CLASSIFICATION: secret (vector store API key)
# REQUIRED. The application refuses to start with this placeholder
# value (the validator in app.config.config rejects it). Generate a
# real one via e.g. `openssl rand -hex 32` and put it here.
QDRANT_API_KEY=change-me-qdrant-key

# Optional immutable OSV advisory cache used for offline prescan and mandatory
# pre-promotion dependency replay. Set this to a host directory only when using
# `docker-compose.osv-offline.yml`; it must contain read-only `snapshot.json`
# and `osv-scanner/<ecosystem>/all.zip` files whose hashes match the manifest.
# OSV_OFFLINE_SNAPSHOT_HOST_DIR=/srv/sccap/osv-snapshot-2026-08-23

# --- Observability (Langfuse v3, optional) ----------------------------
# All values below are placeholders. Generate real keys after first
# `docker compose up langfuse-web` by signing in at $VITE_LANGFUSE_HOST
# and creating a Project. Disabled until LANGFUSE_ENABLED=true.
LANGFUSE_ENABLED=false
# NOTE (ASVS V12.3.1 / V12.3.3): http://langfuse-web:3000 is dev-only.
# For any non-laptop deploy, set LANGFUSE_HOST to an HTTPS endpoint behind
# a reverse proxy, e.g.: LANGFUSE_HOST=https://langfuse.<your-domain>
# Supply CA bundle for self-signed internal CAs via REQUESTS_CA_BUNDLE or
# SSL_CERT_FILE. Plain HTTP must NOT be used in production.
LANGFUSE_HOST=http://langfuse-web:3000
# CLASSIFICATION: internal (Langfuse public key)
LANGFUSE_PUBLIC_KEY=change-me-langfuse-public
# CLASSIFICATION: secret (LLM observability)
LANGFUSE_SECRET_KEY=change-me-langfuse-secret
# UI link in the SCCAP admin panel (read by Vite at build time).
VITE_LANGFUSE_HOST=http://localhost:3001
# Vite dev-server allowed hosts (comma-separated). For cloud deploys, set to
# your domain. Leave empty for local dev — localhost is allowed implicitly.
VITE_ALLOWED_HOSTS=

# --- Distributed worker pools and OpenTelemetry (Task21) ------------
# Compose keeps the historical unified worker. Kubernetes overrides the pool,
# queue, prefetch, and drain values per Helm workload.
RABBITMQ_REPORT_QUEUE=report_export_queue
WORKER_POOL=unified
WORKER_PREFETCH_COUNT=5
WORKER_DRAIN_TIMEOUT_SECONDS=570
WORKER_DRAIN_FILE=/tmp/sccap-worker/drain-requested
WORKER_DRAINED_FILE=/tmp/sccap-worker/drained
REPORT_HANDOFF_READY_TIMEOUT_SECONDS=15
# OTLP contains allowlisted operational metadata only. Never add source code,
# prompts/responses, credentials, request bodies, SQL, or vector payloads.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=sccap
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=60000
# Self-hosting: backing-service credentials. Replace ALL of these before
# bringing the stack up in any non-laptop deploy.
# CLASSIFICATION: secret (Langfuse DB credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 32
LANGFUSE_POSTGRES_PASSWORD=REPLACE_ME
# CLASSIFICATION: secret (ClickHouse credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 32
CLICKHOUSE_PASSWORD=REPLACE_ME
# CLASSIFICATION: secret (Redis credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_ME
MINIO_ROOT_USER=langfuse
# CLASSIFICATION: secret (MinIO credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 32
MINIO_ROOT_PASSWORD=REPLACE_ME
# CLASSIFICATION: secret (encryption key, do not log)
# 64 hex characters required. Generate via: openssl rand -hex 32
# The application refuses to start if this placeholder is not replaced.
LANGFUSE_ENCRYPTION_KEY=REPLACE_ME_64_HEX_CHARS_RUN_openssl_rand_-hex_32
# CLASSIFICATION: secret (Langfuse salt)
LANGFUSE_SALT=REPLACE_ME
# CLASSIFICATION: secret (NextAuth signing secret)
# Replace with a strong random value, e.g.: openssl rand -hex 32
NEXTAUTH_SECRET=REPLACE_ME
# Cap session lifetime so an offboarded SCCAP user can't read traces
# indefinitely (threat model #5). Default 24h.
NEXTAUTH_SESSION_MAXAGE=86400
# Auto-create the first admin on container init. Subsequent users are
# invited from the Langfuse UI.
LANGFUSE_INIT_USER_EMAIL=admin@example.local
# CLASSIFICATION: secret (Langfuse admin password) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 16
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME
# ClickHouse retention. Caps disk growth (threat model #7).
LANGFUSE_TRACE_RETENTION_DAYS=30
# Web UI host port (avoid 3000 — Grafana already owns it).
LANGFUSE_WEB_PORT=3001

# --- Grafana (log_stack profile) -------------------------------------
# CLASSIFICATION: internal (Grafana admin username)
GRAFANA_ADMIN_USER=admin
# CLASSIFICATION: secret (Grafana admin credential) [LONG-LIVED CREDENTIAL — rotate before deploy]
# Replace with a strong random password, e.g.: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# --- Log retention (ADR-010) ----------------------------------------
# Loki retention period. Accepts Loki duration strings: 30d, 4w, 720h.
# Compliance: PCI-DSS 10.5.3 / HIPAA 164.312(b) typically require
# >= 1 year audit-log retention. Operators bound by those regimes
# must set LOKI_RETENTION_DAYS=365d AND provision a larger volume
# for `loki-data` (or ship logs to long-term cold storage before
# upgrade — the compactor deletes >LOKI_RETENTION_DAYS data on its
# first cycle, irreversibly).
LOKI_RETENTION_DAYS=30d

# --- Web Push (#90) -------------------------------------------------------
# VAPID keypair for scan-completion Web Push (desktop notifications that
# fire even when the SCCAP tab is closed). OPTIONAL — leave blank to
# disable Web Push; the app still delivers in-app + tab-open desktop
# notifications. Generate a keypair with:
#   python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives import serialization as s;k=ec.generate_private_key(ec.SECP256R1());b=lambda x:base64.urlsafe_b64encode(x).rstrip(b'=').decode();print('VAPID_PRIVATE_KEY='+b(k.private_numbers().private_value.to_bytes(32,'big')));print('VAPID_PUBLIC_KEY='+b(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sccap.local

# --- Enterprise integration outbound policy -------------------------------
# Deployment-owned exact hostnames only; tenant connector JSON can select but
# cannot extend this list. JSON syntax is required by pydantic-settings.
# Example: ["acme.atlassian.net","siem.example.com","siem.internal.example"]
INTEGRATION_OUTBOUND_ALLOWED_HOSTS=[]
# Optional exact hostname-to-IP pins. Pins avoid DNS entirely and are the only
# supported route to private/on-prem SIEM addresses. Never pin loopback,
# link-local, multicast, unspecified, or reserved addresses.
# Example: {"siem.internal.example":["10.20.30.40"]}
INTEGRATION_OUTBOUND_HOST_PINS={}
# Increment on every deployment policy change. Connector audit snapshots store
# this value plus a digest of the selected host policy.
INTEGRATION_OUTBOUND_POLICY_REVISION=1
